rules_version = '2';

// Altın100 — Firestore security rules (MVP).
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // A user reads only their own profile; admins read all.
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Self-registration may only create a customer or business profile —
      // never an admin (admins are granted out-of-band / by another admin).
      allow create: if isOwner(userId)
        && request.resource.data.role in ['user', 'business'];
      // Users edit their own profile but CANNOT change role or businessId
      // (no self-promotion to admin/business); admins may change anything.
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('businessId', null)
             == resource.data.get('businessId', null)
      );
      allow delete: if isAdmin();
    }

    // Approved businesses are publicly readable; only the owner/admin writes.
    match /businesses/{businessId} {
      allow read: if resource.data.approved == true || isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Services are public for reading; managed by the business owner/admin.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // A user reads their own appointments (customerId) and a business owner
    // reads their inbox (businessOwnerId, denormalised on create). Queries must
    // filter by one of these fields so the list is permitted.
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.businessOwnerId == request.auth.uid
        || isAdmin()
      );
      allow create: if isOwner(request.resource.data.customerId);
      // Customer (their own) or the owning business may update status.
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.businessOwnerId == request.auth.uid
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Loyalty records are read by their owner; written by Cloud Functions/admin.
    match /loyalty/{loyaltyId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Slot locks prevent double-booking. Id = "<businessId>__<datetimeISO>".
    // Any signed-in user can read availability; a customer claims a slot only
    // for themselves; the slot is freed (deleted) on cancel/reject.
    match /slots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.customerId);
      allow delete: if isSignedIn();
    }

    // Reviews are publicly readable; a user writes only their own review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
