rules_version = '2';

// Altın100 — Firestore security rules (MVP).
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // A user reads only their own profile; admins read all.
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Self-registration may only create a customer or business profile —
      // never an admin (admins are granted out-of-band / by another admin).
      allow create: if isOwner(userId)
        && request.resource.data.role in ['user', 'business'];
      // Users edit their own profile but CANNOT change role or businessId
      // (no self-promotion to admin/business); admins may change anything.
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('businessId', null)
             == resource.data.get('businessId', null)
      );
      allow delete: if isAdmin();
    }

    // Approved businesses are publicly readable; only the owner/admin writes.
    match /businesses/{businessId} {
      allow read: if resource.data.approved == true || isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      // A new business must be owned by its creator and start UNAPPROVED —
      // prevents self-approval / bypassing admin review. Admins are exempt
      // (e.g. seeding sample data).
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.approved == false);
      // The owner may edit their business but CANNOT self-approve, transfer
      // ownership, or change their subscription (approved/ownerId/subscription*
      // are admin/webhook-only). Subscription = paid listing access.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.approved == resource.data.approved
        && request.resource.data.get('subscriptionStatus', 'none')
             == resource.data.get('subscriptionStatus', 'none')
        && request.resource.data.get('subscriptionEnd', null)
             == resource.data.get('subscriptionEnd', null)
      );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Services are public for reading; only the owning business / admin writes.
    function ownsBusiness(businessId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId
          == request.auth.uid;
    }
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
      allow update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
    }

    // A user reads their own appointments (customerId) and a business owner
    // reads their inbox (businessOwnerId, denormalised on create). Queries must
    // filter by one of these fields so the list is permitted.
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.businessOwnerId == request.auth.uid
        || isAdmin()
      );
      // Customer books for themselves; the stamped businessOwnerId must match
      // the real owner of the referenced business (no inbox spoofing).
      allow create: if isOwner(request.resource.data.customerId)
        && request.resource.data.status == 'pending'
        && request.resource.data.businessOwnerId ==
           get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId;
      // The owning business / admin may set any status; the customer may only
      // CANCEL their own appointment (not self-approve or self-complete).
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.businessOwnerId == request.auth.uid
        || (resource.data.customerId == request.auth.uid
            && request.resource.data.status == 'cancelled')
      );
      allow delete: if isAdmin();
    }

    // Loyalty records are read by their owner; written by Cloud Functions/admin.
    match /loyalty/{loyaltyId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Slot locks prevent double-booking. Id = "<businessId>__<datetimeISO>".
    // Any signed-in user can read availability; a customer claims a slot only
    // for themselves; the slot is freed (deleted) on cancel/reject.
    match /slots/{slotId} {
      allow read: if isSignedIn();
      // Claimed for oneself; businessOwnerId must match the real business owner.
      allow create: if isOwner(request.resource.data.customerId)
        && request.resource.data.businessOwnerId ==
           get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId;
      // Freed by the booking customer (cancel) or the owning business (reject).
      allow delete: if isSignedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.businessOwnerId == request.auth.uid
        || isAdmin()
      );
    }

    // Reviews are publicly readable; a user writes only their own review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
