# Altın100 — Firebase configuration
#
# Copy this file to ".env" and fill in the values from your Firebase project:
#   Firebase Console → Project settings → "Your apps" → Web app → SDK config.
#
# Leave these blank to run the app in DEMO MODE (in-memory mock data, no backend).
# Variables MUST be prefixed with EXPO_PUBLIC_ so Expo inlines them on every platform.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
