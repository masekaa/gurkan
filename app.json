{
  "expo": {
    "name": "Altın100",
    "slug": "altin100",
    "scheme": "altin100",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#B5862B",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altin100.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.altin100.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0E12",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki işletmelerin sana uzaklığını göstermek için konumun kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İşletme galerisine fotoğraf eklemek için galerine erişim gerekir."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B5862B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09c25178-445e-4961-a7bf-e6b5d56e7038"
      }
    },
    "owner": "maseka04",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/09c25178-445e-4961-a7bf-e6b5d56e7038"
    }
  }
}
